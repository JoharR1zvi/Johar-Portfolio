# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Supabase project — Settings > API Keys in the Supabase dashboard.
# Safe to expose to the browser (Next.js NEXT_PUBLIC_* vars are bundled client-side).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Full database access, bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ — must never reach the browser bundle.
SUPABASE_SECRET_KEY=

# Postgres direct connection password (set when the Supabase project was created).
# Needed for Supabase CLI migrations (supabase link / supabase db push).
SUPABASE_DB_PASSWORD=

# Account-level personal access token (not project-specific) — lets the CLI
# authenticate non-interactively instead of opening a browser.
# Generate at: Supabase dashboard > account avatar (top right) > Access Tokens
# > Generate new token.
SUPABASE_ACCESS_TOKEN=

# Server-only. HMAC key for hashing visitor IPs before they're stored in
# rate_limit_events (contact form abuse prevention) — never store raw IPs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_IP_HASH_SECRET=

# Server-only. Sends the "new contact message" notification email.
# Generate at: resend.com dashboard > API Keys > Create API Key
# (sending-only permission is enough).
RESEND_API_KEY=

# Public. The site's canonical production URL, used to resolve metadata
# (Open Graph/Twitter images, canonical/hreflang links). Defaults to
# http://localhost:3000 for local dev if unset. Update once a real domain
# is live (Phase 7).
NEXT_PUBLIC_SITE_URL=

# Server-only. Google Gemini — primary generation model and the
# gemini-embedding-001 embedding model share this one key. Free tier.
# Generate at: aistudio.google.com > Get API key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Server-only. Groq — fallback generation provider (Qwen3/DeepSeek, free
# tier). Generate at: console.groq.com > API Keys.
GROQ_API_KEY=
